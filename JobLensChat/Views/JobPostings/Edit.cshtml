@model JobPostingFormVm
@{
    ViewData["Title"] = "Edit job posting";
}
<section class="page-header">
    <h1>Edit job posting</h1>
</section>
<section class="card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.PostingId">
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.PostingId">Cancel</a>
        </div>
    </form>
</section>
