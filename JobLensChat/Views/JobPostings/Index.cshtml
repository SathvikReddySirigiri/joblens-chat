@using JobLensChat.Models
@{
    ViewData["Title"] = "Job postings";
    var page = (PageResult<JobPosting>)ViewBag.Page;
    ViewData["PagerPage"] = page.Page;
    ViewData["PagerSize"] = page.PageSize;
    ViewData["PagerTotal"] = page.Total;
    var companies = ViewBag.Companies as IReadOnlyList<Company> ?? Array.Empty<Company>();
    var remote = ViewBag.Remote as bool?;
    var paid = ViewBag.Paid as bool?;
}
<partial name="_Alerts" />
<section class="page-header">
    <div class="page-heading">
        <h1>Job postings</h1>
        <p class="help">Internships and entry-level roles tied to known companies.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add new</a>
</section>
<section class="card">
    <form method="get" class="toolbar" aria-label="Filter postings">
        <div class="field">
            <label for="search">Search</label>
            <input id="search" name="search" value="@ViewBag.Search" />
        </div>
        <div class="field">
            <label for="company">Company</label>
            <select id="company" name="company">
                <option value="">Any</option>
                @foreach (var company in companies)
                {
                    if (ViewBag.Company as int? == company.CompanyId)
                    {
                        <option value="@company.CompanyId" selected>@company.Name</option>
                    }
                    else
                    {
                        <option value="@company.CompanyId">@company.Name</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label for="remote">Remote</label>
            <select id="remote" name="remote">
                <option value="">Any</option>
                @if (remote == true)
                {
                    <option value="true" selected>Remote</option>
                }
                else
                {
                    <option value="true">Remote</option>
                }
                @if (remote == false)
                {
                    <option value="false" selected>On-site</option>
                }
                else
                {
                    <option value="false">On-site</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="paid">Pay</label>
            <select id="paid" name="paid">
                <option value="">Any</option>
                @if (paid == true)
                {
                    <option value="true" selected>Paid</option>
                }
                else
                {
                    <option value="true">Paid</option>
                }
                @if (paid == false)
                {
                    <option value="false" selected>Unpaid</option>
                }
                else
                {
                    <option value="false">Unpaid</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="state">State</label>
            <input id="state" name="state" maxlength="2" value="@ViewBag.State" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-secondary" asp-action="Index">Clear</a>
        </div>
    </form>
</section>
@if (page.Total == 0)
{
    <section class="card empty-state">
        <p>No postings match these filters.</p>
        <a asp-action="Index">Clear filters</a>
    </section>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Posted</th>
                    <th scope="col">Title</th>
                    <th scope="col">Company</th>
                    <th scope="col">Location</th>
                    <th scope="col">State</th>
                    <th scope="col">Remote</th>
                    <th scope="col">Pay</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var posting in page.Items)
                {
                    <tr>
                        <td>@posting.PostedDate</td>
                        <td>@posting.Title</td>
                        <td>@posting.CompanyName</td>
                        <td>@posting.Location</td>
                        <td>@posting.State</td>
                        <td>@(posting.IsRemote ? "Yes" : "No")</td>
                        <td>@(posting.IsPaid && posting.PayRatePerHour is not null ? posting.PayRatePerHour.Value.ToString("$#,##0.00") + "/hr" : "Unpaid")</td>
                        <td><a asp-action="Details" asp-route-id="@posting.PostingId">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
