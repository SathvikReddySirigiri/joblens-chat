@{
    ViewData["Title"] = "Architecture";
    ViewData["PageTitle"] = "Architecture";
    ViewData["PageSubtitle"] = "Request flow, Clean Architecture layers, MCP tools, and security practices.";
    ViewData["UseMermaid"] = true;
}

<section class="page-header">
    <partial name="_PageHeader" />
</section>

<section class="section" aria-labelledby="flow-title">
    <h2 id="flow-title">Request flow</h2>
    <div class="card mermaid-panel">
        <pre class="mermaid" role="img" aria-label="JobLens architecture flowchart">
flowchart TB
  subgraph azure["Azure App Service single instance"]
    Browser["Browser"]
    MVC["MVC Controllers"]
    AppSvc["Application services"]
    Infra["Infrastructure repositories"]
    Sqlite[("SQLite joblens.db")]
    ChatPage["Chat page"]
    Orch["ChatOrchestrator"]
    McpClient["MCP client"]
    McpEndpoint["/mcp with X-Api-Key"]
    McpTools["MCP tools 9 read-only"]
    Browser --> MVC --> AppSvc --> Infra --> Sqlite
    ChatPage --> Orch --> McpClient --> McpEndpoint --> McpTools --> AppSvc
  end
  subgraph external["External services"]
    Rdap["RDAP registries"]
    Edgar["SEC EDGAR"]
    UsaJobs["USAJOBS API"]
    Aoi["Azure OpenAI"]
  end
  Infra --> Rdap
  Infra --> Edgar
  Infra --> UsaJobs
  Orch --> Aoi
        </pre>
    </div>
    <ol class="help" aria-label="Text alternative for the architecture flowchart">
        <li>Browser calls MVC controllers for CRUD, checks, dashboard, Jobs (two tabs), and chat UI.</li>
        <li>Controllers call Application services; services call Infrastructure repositories; SQL stays in repositories against SQLite.</li>
        <li>Chat page uses ChatOrchestrator → MCP HTTP client → <code>/mcp</code> (optional <code>X-Api-Key</code>) → read-only MCP tools → Application services.</li>
        <li>Infrastructure also calls RDAP, SEC EDGAR, and USAJOBS for live Jobs; ChatOrchestrator may call Azure OpenAI when configured.</li>
        <li>Everything above runs in a single Azure App Service instance for class deployment.</li>
    </ol>
</section>

<section class="card" aria-labelledby="layers-title">
    <h2 id="layers-title">Clean Architecture layers</h2>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Layer</th>
                    <th scope="col">Contains</th>
                    <th scope="col">Depends on</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Domain</td>
                    <td>Entities, constants (statuses, paging)</td>
                    <td>Nothing else in the solution</td>
                </tr>
                <tr>
                    <td>Application</td>
                    <td>Services, DTOs, repository interfaces, validation rules</td>
                    <td>Domain only</td>
                </tr>
                <tr>
                    <td>Infrastructure</td>
                    <td>ADO.NET SQLite repositories, RDAP/EDGAR clients, password hasher, AI factory</td>
                    <td>Application + Domain</td>
                </tr>
                <tr>
                    <td>Web</td>
                    <td>MVC, Razor, ChatOrchestrator, MCP tool hosts, cookie auth</td>
                    <td>Application (+ Infrastructure via DI composition)</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="help">Dependency rule: Web and Infrastructure depend inward on Application and Domain. Controllers never contain SQL and never call repositories directly.</p>
</section>

<section class="section" aria-labelledby="mcp-title">
    <h2 id="mcp-title">MCP tools</h2>
    <p class="help">All tools are <strong>read-only</strong>. Writes happen only through the website with sign-in and roles—never through MCP.</p>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Purpose</th>
                    <th scope="col">Guardrails</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>get_domain_report</code></td>
                    <td>Read</td>
                    <td>Reports for one domain</td>
                    <td>Parameterized; bounded rows</td>
                </tr>
                <tr>
                    <td><code>search_scam_reports</code></td>
                    <td>Read</td>
                    <td>Filter scam reports</td>
                    <td>Validated enums; max 20 rows</td>
                </tr>
                <tr>
                    <td><code>summarize_scams</code></td>
                    <td>Read</td>
                    <td>Aggregate scam summary</td>
                    <td>No free-form SQL</td>
                </tr>
                <tr>
                    <td><code>top_impersonated_companies</code></td>
                    <td>Read</td>
                    <td>Top companies by approved reports</td>
                    <td>Bounded list</td>
                </tr>
                <tr>
                    <td><code>check_recruiter_email</code></td>
                    <td>Read</td>
                    <td>Risk score for an email</td>
                    <td>Email validation</td>
                </tr>
                <tr>
                    <td><code>search_jobs</code></td>
                    <td>Read</td>
                    <td>Search JobLens postings (Jobs tab)</td>
                    <td>Bounded page size</td>
                </tr>
                <tr>
                    <td><code>search_live_jobs</code></td>
                    <td>Read (external)</td>
                    <td>Live openings from USAJOBS (Jobs tab)</td>
                    <td>Allow-listed filters; not stored</td>
                </tr>
                <tr>
                    <td><code>get_company_profile</code></td>
                    <td>Read</td>
                    <td>Company activity snapshot</td>
                    <td>By name / id</td>
                </tr>
                <tr>
                    <td><code>analyze_offer</code></td>
                    <td>Read</td>
                    <td>Score offer text patterns</td>
                    <td>Length limits; no persistence of raw text</td>
                </tr>
                <tr>
                    <td><code>lookup_domain_registration</code></td>
