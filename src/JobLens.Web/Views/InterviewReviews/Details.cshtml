@model InterviewReview
@{
    ViewData["Title"] = Model.Role;
    ViewData["PageTitle"] = Model.Role;
    ViewData["PageSubtitle"] = $"{Model.CompanyName} · {Model.ReviewDate}";
}
<partial name="_Alerts" />
<section class="page-header">
    <partial name="_PageHeader" />
    <div class="header-actions">
        @if (ViewBag.CanEdit == true)
        {
            <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.ReviewId">Edit</a>
        }
        @if (ViewBag.CanDelete == true)
        {
            <a class="btn btn-secondary" asp-action="Delete" asp-route-id="@Model.ReviewId">Delete</a>
        }
    </div>
</section>
<section class="card">
    <p><partial name="_Stars" model="Model.Rating" /></p>
    <dl class="detail-list">
        <div><dt>Company</dt><dd><a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.CompanyId">@Model.CompanyName</a></dd></div>
        <div><dt>Legitimate</dt><dd>@(Model.WasLegit ? "Yes" : "No")</dd></div>
        <div><dt>Experience</dt><dd>@Model.Experience</dd></div>
    </dl>
</section>
