@model InterviewReview
@{
    ViewData["Title"] = "Delete interview experience";
    ViewData["PageTitle"] = "Delete this review?";
    ViewData["PageSubtitle"] = $"{Model.Role} · {Model.CompanyName} · {Model.ReviewDate}. This cannot be undone.";
}
<partial name="_Alerts" />
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.ReviewId">
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Delete review</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ReviewId">Cancel</a>
        </div>
    </form>
</section>
