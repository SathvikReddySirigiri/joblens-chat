@using JobLens.Web.ViewModels
@{
    ViewData["Title"] = "Interview experiences";
    var page = (PageResult<InterviewReview>)ViewBag.Page;
    ViewData["PagerPage"] = page.Page;
    ViewData["PagerSize"] = page.PageSize;
    ViewData["PagerTotal"] = page.Total;
    var companies = ViewBag.Companies as IReadOnlyList<Company> ?? Array.Empty<Company>();
    var legit = ViewBag.Legit as bool?;
    var suspiciousOnly = legit == false;
}
@{
    ViewData["PageTitle"] = "Interview experiences";
    ViewData["PageSubtitle"] = "Student notes on whether an interview felt legitimate — and flags when it looked like a scam.";
}
<section class="page-header">
    <partial name="_PageHeader" />
    @if (ViewBag.IsSignedIn == true)
    {
        <div class="header-actions">
            <a class="btn btn-primary" asp-action="Create">Add new</a>
        </div>
    }
</section>
<section class="card">
    <form method="get" class="filter-bar" aria-label="Filter interview experiences">
        <div class="field">
            <label for="company">Company</label>
            <select id="company" name="company">
                <option value="">Any</option>
                @foreach (var company in companies)
                {
                    if (ViewBag.Company as int? == company.CompanyId)
                    {
                        <option value="@company.CompanyId" selected>@company.Name</option>
                    }
                    else
                    {
                        <option value="@company.CompanyId">@company.Name</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label for="rating">Rating</label>
            <select id="rating" name="rating">
                <option value="">Any</option>
                @for (var rating = 1; rating <= 5; rating++)
                {
                    if (ViewBag.Rating as int? == rating)
                    {
                        <option value="@rating" selected>@rating</option>
                    }
                    else
                    {
                        <option value="@rating">@rating</option>
                    }
                }
            </select>
        </div>
        <div class="field field-checkbox">
            <label>
                @if (suspiciousOnly)
                {
                    <input type="checkbox" name="legit" value="false" checked />
                }
                else
                {
                    <input type="checkbox" name="legit" value="false" />
                }
                Suspicious only
            </label>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-secondary" asp-action="Index">Clear</a>
        </div>
    </form>
</section>
@if (page.Total == 0)
{
    <section class="card empty-state">
        <p>No interview experiences match these filters.</p>
        <a asp-action="Index">Clear filters</a>
    </section>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Company</th>
                    <th scope="col">Role</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in page.Items)
                {
                    <tr>
                        <td>@review.ReviewDate</td>
                        <td>@review.CompanyName</td>
                        <td>@review.Role</td>
                        <td><partial name="_Stars" model="review.Rating" /></td>
                        <td>
                            @if (!review.WasLegit)
                            {
                                <span class="badge badge-high">⚠ Suspicious</span>
                            }
                            else
                            {
                                <span class="badge badge-low">Legitimate</span>
                            }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@review.ReviewId">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
