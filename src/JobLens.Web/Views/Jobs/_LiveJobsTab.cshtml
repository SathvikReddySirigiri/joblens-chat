@model LiveJobsPage
@{
    var search = Model.Search;
    var usaCategories = LiveJobsService.UsaJobsCategories;
    var pageSize = 20;
}

<section class="card">
    <form method="get" asp-controller="Jobs" asp-action="Index" class="filter-bar" aria-label="Live job filters">
        <input type="hidden" name="tab" value="@JobsPageVm.LiveTab" />
        <div class="field">
            <label for="keyword">Keyword</label>
            <input id="keyword" name="keyword" value="@search.Keyword" maxlength="60" placeholder="data, analyst, intern…" />
        </div>
        <div class="field">
            <label for="location">Location</label>
            <input id="location" name="location" value="@search.Location" maxlength="60" placeholder="Tampa, FL or Remote" />
        </div>
        <div class="field">
            <label for="categoryCode">Category</label>
            <select id="categoryCode" name="categoryCode">
                <option value="">Any category</option>
                @foreach (var category in usaCategories)
                {
                    if (search.CategoryCode == category.Code)
                    {
                        <option value="@category.Code" selected>@category.Label (@category.Code)</option>
                    }
                    else
                    {
                        <option value="@category.Code">@category.Label (@category.Code)</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label for="hiringPath">Hiring path</label>
            <select id="hiringPath" name="hiringPath">
                @if ((search.HiringPath ?? "student") == "student")
                {
                    <option value="student" selected>Students &amp; interns</option>
                }
                else
                {
                    <option value="student">Students &amp; interns</option>
                }
                @if (search.HiringPath == "graduates")
                {
                    <option value="graduates" selected>Recent graduates</option>
                }
                else
                {
                    <option value="graduates">Recent graduates</option>
                }
                @if (search.HiringPath == "public")
                {
                    <option value="public" selected>Open to the public</option>
                }
                else
                {
                    <option value="public">Open to the public</option>
                }
            </select>
        </div>
        <div class="field field-checkbox">
            <label>
                @if (search.RemoteOnly)
                {
                    <input type="checkbox" name="remoteOnly" value="true" checked />
                }
                else
                {
                    <input type="checkbox" name="remoteOnly" value="true" />
                }
                Remote only
            </label>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Search live jobs</button>
        </div>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.DebugDetail))
{
    <p class="live-debug" role="status">Debug: @Model.DebugDetail</p>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p class="alert alert-error" role="alert">@Model.Message</p>
}

@if (Model.Items.Count == 0 && string.IsNullOrWhiteSpace(Model.Message))
{
    <p class="alert alert-neutral" role="status">No live jobs matched these filters. Try a broader location or another category.</p>
}

@if (Model.Items.Count > 0)
{
    var from = ((Model.Page - 1) * pageSize) + 1;
    var to = from + Model.Items.Count - 1;
    var total = Model.Page < Model.PageCount
        ? Model.PageCount * pageSize
        : to;
    <p class="help live-meta">
        Showing @from–@to of @total jobs
        @if (Model.FromCache)
        {
            <span>· served from short-term cache</span>
        }
    </p>

    <div class="live-job-list">
        @foreach (var listing in Model.Items)
        {
            var job = listing.Job;
            var trust = listing.Trust;
            var hasScamReports = trust.ApprovedScamReports > 0;
            <article class="card live-job-card">
                <header class="live-job-header">
                    <h2 class="live-job-title">@job.Title</h2>
                    <p class="live-meta">
                        <span>@job.CompanyName</span>
                        @if (!string.IsNullOrWhiteSpace(job.Locations))
                        {
                            <span>· @job.Locations</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(job.PublishedDate))
                        {
                            <span>· Posted @job.PublishedDate</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(job.CloseDate))
                        {
                            <span>· Closes @job.CloseDate</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(job.PayRange))
                        {
                            <span>· @job.PayRange</span>
                        }
                    </p>
                </header>

                <div class="chip-row">
                    @if (job.IsRemote)
                    {
                        <span class="badge badge-neutral">Remote</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(job.Levels))
                    {
                        <span class="badge badge-neutral">@job.Levels</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(job.Categories))
                    {
                        <span class="badge badge-neutral">@job.Categories</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(job.DescriptionSnippet))
                {
                    <p class="live-job-snippet">@job.DescriptionSnippet</p>
                }

                <footer class="live-job-footer">
                    <div class="live-trust">
                        <details>
                            <summary class="live-trust-summary">
                                @if (trust.IsOfficialGovSource)
                                {
                                    <span class="live-trust-badge ok">✓ Official .gov source</span>
                                }
                                else if (hasScamReports)
                                {
                                    <span class="live-trust-badge warn">⚠ @trust.ApprovedScamReports scam reports</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(trust.MatchedCompany))
                                {
                                    <span class="live-trust-badge ok">Matched: @trust.MatchedCompany</span>
                                }
                                else
                                {
                                    <span class="live-trust-badge">No company match</span>
                                }
                            </summary>
                            <div class="live-trust-body">
                                @if (!string.IsNullOrWhiteSpace(trust.OfficialDomain))
                                {
                                    <p class="help">Official domain: @trust.OfficialDomain</p>
                                }
                                <ul>
                                    @foreach (var note in trust.Notes)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>
                                <div class="live-trust-links">
                                    <a class="btn-link" asp-controller="CheckRecruiter" asp-action="Index">Check recruiter</a>
                                    @if (listing.MatchedCompanyId is int companyId)
                                    {
                                        <a class="btn-link" asp-controller="ScamReports" asp-action="Create" asp-route-company="@companyId">Report scam</a>
                                    }
                                    else if (!trust.IsOfficialGovSource)
                                    {
                                        <a class="btn-link" asp-controller="ScamReports" asp-action="Create">Report scam</a>
                                    }
                                </div>
                            </div>
                        </details>
                    </div>

                    <div class="live-job-actions">
                        @if (!string.IsNullOrWhiteSpace(job.ApplyUrl))
                        {
                            <a class="btn btn-primary"
                               href="@job.ApplyUrl"
                               target="_blank"
                               rel="noopener noreferrer nofollow">Apply ↗</a>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-secondary"
                               asp-controller="Applications"
                               asp-action="Create"
                               asp-route-company="@job.CompanyName"
                               asp-route-title="@job.Title"
                               asp-route-url="@job.ApplyUrl"
                               asp-route-source="LiveJobs">Track</a>
                        }
                    </div>
                </footer>
            </article>
        }
    </div>

    <nav class="pager live-pager" aria-label="Live jobs pages">
        @if (Model.Page > 1)
        {
            <a class="btn btn-secondary"
               asp-controller="Jobs"
               asp-action="Index"
               asp-route-tab="@JobsPageVm.LiveTab"
               asp-route-categoryCode="@search.CategoryCode"
               asp-route-location="@search.Location"
               asp-route-keyword="@search.Keyword"
               asp-route-hiringPath="@search.HiringPath"
               asp-route-remoteOnly="@(search.RemoteOnly ? "true" : null)"
               asp-route-page="@(Model.Page - 1)">Previous</a>
        }
        @if (Model.Page < Math.Min(Model.PageCount, 5))
        {
            <a class="btn btn-secondary"
               asp-controller="Jobs"
               asp-action="Index"
               asp-route-tab="@JobsPageVm.LiveTab"
               asp-route-categoryCode="@search.CategoryCode"
               asp-route-location="@search.Location"
               asp-route-keyword="@search.Keyword"
               asp-route-hiringPath="@search.HiringPath"
               asp-route-remoteOnly="@(search.RemoteOnly ? "true" : null)"
               asp-route-page="@(Model.Page + 1)">Next</a>
        }
    </nav>
}

<p class="help live-attribution">
    @Model.AttributionText
    <a href="@Model.AttributionUrl" target="_blank" rel="noopener noreferrer">@Model.AttributionUrl</a>
</p>
