@model ScamReport
@{
    ViewData["Title"] = "Delete scam report";
    ViewData["PageTitle"] = "Delete this report?";
    ViewData["PageSubtitle"] = $"{Model.RecruiterEmail} · {Model.ScamType} · {Model.ReportedDate}. This cannot be undone.";
}
<partial name="_Alerts" />
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.ReportId">
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Delete report</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ReportId">Cancel</a>
        </div>
    </form>
</section>
