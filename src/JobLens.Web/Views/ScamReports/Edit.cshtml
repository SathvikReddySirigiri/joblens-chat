@model ScamReportFormVm
@{
    ViewData["Title"] = "Edit scam report";
    ViewData["PageTitle"] = "Edit scam report";
    ViewData["PageSubtitle"] = "Status stays as it is. The domain is taken from the email again.";
}
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.ReportId">
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ReportId">Cancel</a>
        </div>
    </form>
</section>
