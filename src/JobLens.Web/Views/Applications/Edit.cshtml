@model JobApplicationFormVm
@{
    ViewData["Title"] = "Edit application";
    ViewData["PageTitle"] = "Edit application";
    ViewData["PageSubtitle"] = $"{Model.CompanyName} · {Model.RoleTitle}";
}
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="Edit">
        @Html.AntiForgeryToken()
        <partial name="_Form" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ApplicationId">Cancel</a>
        </div>
    </form>
</section>
