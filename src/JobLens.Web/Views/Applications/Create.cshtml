@model JobApplicationFormVm
@{
    ViewData["Title"] = "Track a job";
    ViewData["PageTitle"] = "Track a job";
    ViewData["PageSubtitle"] = "Save a role to your pipeline and optionally check the recruiter email for risk.";
}
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <partial name="_Form" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save application</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
