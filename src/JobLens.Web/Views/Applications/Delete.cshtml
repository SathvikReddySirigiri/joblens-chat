@model JobApplication
@{
    ViewData["Title"] = "Delete application";
    ViewData["PageTitle"] = "Delete this application?";
    ViewData["PageSubtitle"] = $"{Model.RoleTitle} · {Model.CompanyName} · {Model.Status}. This cannot be undone.";
}
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="Delete" asp-route-id="@Model.ApplicationId">
        @Html.AntiForgeryToken()
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Delete application</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ApplicationId">Cancel</a>
        </div>
    </form>
</section>
