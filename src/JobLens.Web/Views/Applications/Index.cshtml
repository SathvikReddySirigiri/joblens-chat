@using JobLens.Domain.Constants
@{
    ViewData["Title"] = "My Applications";
    var page = (PageResult<JobApplicationListItem>)ViewBag.Page;
    var pipeline = (JobApplicationPipeline)ViewBag.Pipeline;
    var tabs = ViewBag.StatusTabs as IReadOnlyList<JobApplicationStatusCount> ?? Array.Empty<JobApplicationStatusCount>();
    var statuses = ViewBag.Statuses as string[] ?? ApplicationStatuses.All;
    ViewData["PagerPage"] = page.Page;
    ViewData["PagerSize"] = page.PageSize;
    ViewData["PagerTotal"] = page.Total;
    var totalAll = tabs.Sum(tab => tab.Count);
}

<section class="page-header">
    <div class="page-heading">
        <h1>My Applications</h1>
        <p class="help">Track roles you saved or applied to, follow-ups, and recruiter risk signals.</p>
    </div>
    <div class="header-actions">
        <a class="btn btn-primary" asp-action="Create">Track a job</a>
    </div>
</section>

<section class="kpi-grid" aria-label="Pipeline summary">
    <article class="card kpi">
        <h2>Applied</h2>
        <p class="kpi-value">@pipeline.Applied</p>
    </article>
    <article class="card kpi">
        <h2>Interviewing</h2>
        <p class="kpi-value">@pipeline.Interviewing</p>
    </article>
    <article class="card kpi">
        <h2>Offers</h2>
        <p class="kpi-value">@pipeline.Offers</p>
    </article>
    <article class="card kpi">
        <h2>Response rate</h2>
        <p class="kpi-value">@pipeline.ResponseRatePercent.ToString("0.#")%</p>
    </article>
</section>

<section class="card">
    <nav class="tab-list" aria-label="Filter by status">
        <a class="nav-link @(string.IsNullOrWhiteSpace(ViewBag.Status as string) ? "active" : null)"
           asp-action="Index"
           asp-route-search="@ViewBag.Search">All (@totalAll)</a>
        @foreach (var tab in tabs)
        {
            <a class="nav-link @(string.Equals(ViewBag.Status as string, tab.Status, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
               asp-action="Index"
               asp-route-status="@tab.Status"
               asp-route-search="@ViewBag.Search">@tab.Status (@tab.Count)</a>
        }
    </nav>
    <form method="get" class="toolbar" aria-label="Search applications">
        @if (!string.IsNullOrWhiteSpace(ViewBag.Status as string))
        {
            <input type="hidden" name="status" value="@ViewBag.Status" />
        }
        <div class="field">
            <label for="search">Search</label>
            <input id="search" name="search" value="@ViewBag.Search" maxlength="120" placeholder="Company, role, or notes" />
        </div>
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
</section>

@if (page.Total == 0)
{
    <section class="card empty-state">
        <p>No applications match these filters.</p>
        <a asp-action="Create">Track your first job</a>
    </section>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Company</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Applied</th>
                    <th scope="col">Follow-up</th>
                    <th scope="col">Risk</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in page.Items)
                {
                    <tr>
                        <td>@item.CompanyName</td>
                        <td>@item.RoleTitle</td>
                        <td>
                            <form method="post" asp-action="QuickStatus" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ApplicationId" />
                                <input type="hidden" name="filterStatus" value="@ViewBag.Status" />
                                <input type="hidden" name="search" value="@ViewBag.Search" />
                                <input type="hidden" name="page" value="@(page.Page)" />
                                <label class="visually-hidden" for="status-@item.ApplicationId">Status</label>
                                <select id="status-@item.ApplicationId" name="status" onchange="this.form.submit()">
                                    @foreach (var status in statuses)
                                    {
                                        if (item.Status == status)
                                        {
                                            <option value="@status" selected>@status</option>
                                        }
                                        else
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    }
                                </select>
                            </form>
                        </td>
                        <td>@(item.AppliedDate ?? "—")</td>
                        <td>
                            @(item.NextFollowUpDate ?? "—")
                            @if (item.FollowUpDue)
                            {
                                <span class="badge badge-medium">Follow-up due</span>
                            }
                        </td>
                        <td>
                            @if (string.Equals(item.RiskVerdict, ApplicationRiskVerdicts.High, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-high">High</span>
                                @if (!string.IsNullOrWhiteSpace(item.RecruiterEmail))
                                {
                                    <a asp-controller="CheckRecruiter" asp-action="Index" asp-route-email="@item.RecruiterEmail">Why?</a>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(item.RiskVerdict))
                            {
                                var badge = string.Equals(item.RiskVerdict, ApplicationRiskVerdicts.Medium, StringComparison.OrdinalIgnoreCase)
                                    ? "badge-medium"
                                    : "badge-low";
                                <span class="badge @badge">@item.RiskVerdict</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.ApplicationId">Details</a>
                            <span aria-hidden="true">·</span>
                            <a asp-action="Edit" asp-route-id="@item.ApplicationId">Edit</a>
                            <span aria-hidden="true">·</span>
                            <a asp-action="Delete" asp-route-id="@item.ApplicationId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" />
}
