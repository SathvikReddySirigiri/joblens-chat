@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["PageTitle"] = "Something went wrong";
    ViewData["PageSubtitle"] = "The request could not be completed. Try again or return home.";
}
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <p>JobLens hit an unexpected problem while handling this request. No technical details are shown outside Development.</p>
    @if (Model.ShowRequestId)
    {
        <p class="alert alert-error" role="status"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <p class="form-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        <a class="btn btn-secondary" asp-controller="About" asp-action="Index">About JobLens</a>
    </p>
</section>
