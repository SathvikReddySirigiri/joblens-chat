@model DataCounts
@{
    ViewData["Title"] = "Home";
}

<section class="hero home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-grid">
        <div class="home-hero-copy">
            <p class="pill">Job &amp; internship scam shield for students and career centers</p>
            <h1 id="home-hero-title">We verify the recruiter, not just the job.</h1>
            <p class="lead">JobLens checks recruiter emails, domains, and community scam reports so career centers and students can decide what to trust before anyone sends money or personal data.</p>
            <form class="quick-check" method="get" asp-controller="CheckRecruiter" asp-action="Index" aria-label="Quick recruiter check">
                <label class="visually-hidden" for="home-email">Recruiter email</label>
                <input id="home-email" name="email" type="email" placeholder="recruiter@example.com" autocomplete="off" required />
                <button class="btn btn-primary" type="submit">Check</button>
            </form>
            <div class="header-actions home-hero-actions">
                <a class="btn btn-primary-outline" asp-controller="OfferAnalyzer" asp-action="Index">Analyze an offer</a>
                <a class="btn btn-secondary" asp-controller="Chat" asp-action="Index">Ask JobLens</a>
            </div>
        </div>
        <aside class="home-hero-sample" aria-label="Sample recruiter check result">
            <article class="card sample-result-card">
                <p class="sample-result-email">hr@amaz0n-careers.net</p>
                <p>
                    <span class="badge badge-high">High risk</span>
                    <span class="score-label">92/100</span>
                </p>
                <h2 class="sample-result-heading">Red flags</h2>
                <ul class="reason-list">
                    <li>Look-alike domain of amazon.com</li>
                    <li>Domain registered recently</li>
                    <li>2 approved scam reports for this domain</li>
                </ul>
                <p>
                    <button type="button" class="btn btn-secondary" data-fill-email="hr@amaz0n-careers.net" data-fill-target="home-email">Try it</button>
                </p>
            </article>
        </aside>
    </div>
</section>

<section class="stats-strip" aria-label="Live database counts">
    <div class="stat-card">
        <p class="stat-label">Scam reports</p>
        <p class="stat-value">@Model.ScamReports</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Approved reports</p>
        <p class="stat-value">@Model.Approved</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Companies tracked</p>
        <p class="stat-value">@Model.Companies</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Recruiter checks run</p>
        <p class="stat-value">@Model.CheckLogs</p>
    </div>
</section>

<section class="section" aria-labelledby="features-title">
    <h2 id="features-title">What JobLens does</h2>
    <div class="feature-grid">
        <a class="feature-card" asp-controller="CheckRecruiter" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">✉</span>
            <h3>Check Recruiter</h3>
            <p>Score a recruiter email against domains, look-alikes, and approved reports.</p>
        </a>
        <a class="feature-card" asp-controller="OfferAnalyzer" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">📄</span>
            <h3>Offer Analyzer</h3>
            <p>Paste or upload an offer letter; redacted text is scored for common scam patterns.</p>
        </a>
        <a class="feature-card" asp-controller="ScamReports" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">📋</span>
            <h3>Scam Reports</h3>
            <p>Browse community reports; students can submit; moderators approve or reject.</p>
        </a>
        <a class="feature-card" asp-controller="Jobs" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">💼</span>
            <h3>Jobs</h3>
            <p>Two tabs: live openings from USAJOBS (or The Muse) with trust signals, and JobLens-curated postings with Smart Search.</p>
        </a>
        <a class="feature-card" asp-controller="Dashboard" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">📊</span>
            <h3>Scam Insights Dashboard</h3>
            <p>Live charts for trends, companies, channels, and money requested.</p>
        </a>
        <a class="feature-card" asp-controller="Chat" asp-action="Index">
            <span class="feature-icon" aria-hidden="true">💬</span>
            <h3>Ask JobLens</h3>
            <p>Ask questions grounded only in read-only MCP tools over the database.</p>
        </a>
    </div>
</section>

<section class="section" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ol class="how-steps">
        <li class="card">
            <span class="step">1</span>
            <h3>Enter a recruiter or offer</h3>
            <p>Start with an email, claimed company, or offer text from a student or staff member.</p>
        </li>
        <li class="card">
            <span class="step">2</span>
            <h3>JobLens checks the evidence</h3>
            <p>We compare domains, community reports, and live registry panels (RDAP and SEC EDGAR).</p>
        </li>
        <li class="card">
            <span class="step">3</span>
            <h3>Clear verdict and next steps</h3>
            <p>See a risk score, reasons, and what to do before anyone replies or sends money.</p>
        </li>
    </ol>
</section>

<section class="section" aria-labelledby="audience-title">
    <h2 id="audience-title">Built for</h2>
    <div class="audience-grid">
        <article class="card">
            <h3>Students</h3>
            <p>Check a cold outreach email or sketchy offer before you share documents or deposit a check.</p>
        </article>
        <article class="card">
            <h3>Career-center moderators</h3>
            <p>Review pending reports, manage reference data, and see trends on the dashboard.</p>
        </article>
        <article class="card">
            <h3>Employers</h3>
            <p>Understand how impersonation shows up in reports that use your company name as cover.</p>
        </article>
    </div>
</section>

<section class="cta-band" aria-labelledby="cta-title">
    <h2 id="cta-title">Got a suspicious recruiter message?</h2>
    <p>Run a check in seconds, or file a report for the career center to review.</p>
    <div class="header-actions">
        <a class="btn btn-primary" asp-controller="CheckRecruiter" asp-action="Index">Check Recruiter</a>
        <a class="btn btn-secondary" asp-controller="ScamReports" asp-action="Create">Report a scam</a>
    </div>
</section>
