@model HomePageVm
@{
    ViewData["Title"] = "Home";
    var stats = Model.Stats;
    var redFlag = Model.RedFlagOfWeek;
}

<section class="hero home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-grid">
        <div class="home-hero-copy">
            <p class="pill">Job &amp; internship scam shield for students and career centers</p>
            <h1 id="home-hero-title">We verify the recruiter, not just the job.</h1>
            <p class="lead">JobLens checks recruiter emails, domains, and community scam reports so career centers and students can decide what to trust before anyone sends money or personal data.</p>
            <form class="quick-check" method="get" asp-controller="CheckRecruiter" asp-action="Index" aria-label="Quick recruiter check">
                <label class="visually-hidden" for="home-email">Recruiter email</label>
                <input id="home-email" name="email" type="email" placeholder="recruiter@example.com" autocomplete="off" required />
                <button class="btn btn-primary" type="submit">Check</button>
            </form>
            <div class="header-actions home-hero-actions">
                <a class="btn btn-secondary" asp-controller="OfferAnalyzer" asp-action="Index">Analyze an offer</a>
                <a class="btn btn-secondary" asp-controller="Chat" asp-action="Index">Ask JobLens</a>
            </div>
        </div>
        <aside class="home-hero-sample" aria-label="Sample recruiter check result">
            <article class="card sample-result-card">
                <p class="sample-result-email">hr@amaz0n-careers.net</p>
                <p>
                    <span class="badge badge-high">High risk</span>
                    <span class="score-label">92/100</span>
                </p>
                <h2 class="sample-result-heading">Red flags</h2>
                <ul class="reason-list">
                    <li>Look-alike domain of amazon.com</li>
                    <li>Domain registered recently</li>
                    <li>2 approved scam reports for this domain</li>
                </ul>
                <p>
                    <button type="button" class="btn btn-secondary" data-fill-email="hr@amaz0n-careers.net" data-fill-target="home-email">Try it</button>
                </p>
            </article>
        </aside>
    </div>
</section>

@if (Model.StudentWeek is { } student)
{
    <section class="card home-panel" aria-labelledby="your-week-title">
        <h2 id="your-week-title">Your week</h2>
        <div class="home-week-grid">
            <div>
                <h3>Follow-ups due (@student.FollowUpsDueCount)</h3>
                @if (student.NextFollowUps.Count == 0)
                {
                    <p class="help">No follow-ups due right now.</p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var item in student.NextFollowUps)
                        {
                            <li>
                                <a asp-controller="Applications" asp-action="Details" asp-route-id="@item.ApplicationId">@item.CompanyName · @item.RoleTitle</a>
                                <span class="help">@item.NextFollowUpDate</span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div>
                <h3>High-risk applications</h3>
                @if (student.HighRiskApplications.Count == 0)
                {
                    <p class="help">No High risk applications in your pipeline.</p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var item in student.HighRiskApplications)
                        {
                            <li>
                                <a asp-controller="Applications" asp-action="Details" asp-route-id="@item.ApplicationId">@item.CompanyName · @item.RoleTitle</a>
                                <span class="badge badge-high">@item.RiskVerdict</span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div>
                <h3>Resume privacy</h3>
                @if (!student.HasResume)
                {
                    <p class="help"><a asp-controller="Resume" asp-action="Index">Upload your resume</a> for a privacy check before you apply.</p>
                }
                else if (student.ResumePrivacyIssueCount is int issues && issues > 0)
                {
                    <p><a asp-controller="Resume" asp-action="Index">@issues privacy issue@(issues == 1 ? "" : "s")</a> on your saved resume.</p>
                }
                else
                {
                    <p class="help">No privacy issues on your saved resume.</p>
                }
            </div>
        </div>
        <div class="header-actions">
            <a class="btn btn-primary" asp-controller="Applications" asp-action="Create">Track a job</a>
            <a class="btn btn-secondary" asp-controller="EmailDrafts" asp-action="Index">Draft email</a>
            <a class="btn btn-secondary" asp-controller="CheckRecruiter" asp-action="Index">Check recruiter</a>
        </div>
    </section>
}
else if (Model.ModeratorWeek is { } moderator)
{
    <section class="card home-panel" aria-labelledby="mod-week-title">
        <h2 id="mod-week-title">Moderation</h2>
        <p>
            <a asp-controller="ScamReports" asp-action="Index" asp-route-status="Pending">@moderator.PendingReports reports waiting for review</a>
            · @moderator.NewReportsThisWeek new reports this week
        </p>
        <div class="header-actions">
            <a class="btn btn-primary" asp-controller="ScamReports" asp-action="Index" asp-route-status="Pending">Open queue</a>
            <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Open dashboard</a>
        </div>
    </section>
}

<section class="stats-grid" aria-label="Impact stats">
    <article class="stat-card">
        <p class="stat-label">Approved reports</p>
        <p class="stat-value">@stats.ApprovedReports</p>
    </article>
    <article class="stat-card">
        <p class="stat-label">Companies impersonated</p>
        <p class="stat-value">@stats.CompaniesImpersonated</p>
    </article>
    <article class="stat-card">
        <p class="stat-label">$ requested by scammers</p>
        <p class="stat-value">@stats.AmountFormatted</p>
    </article>
    <article class="stat-card">
        <p class="stat-label">Recruiter checks run</p>
        <p class="stat-value">@stats.RecruiterChecks</p>
    </article>
</section>

<section class="section" aria-labelledby="alerts-title">
    <div class="section-heading">
        <h2 id="alerts-title">Latest scam alerts</h2>
        <a asp-controller="ScamReports" asp-action="Index" asp-route-status="Approved">View all reports →</a>
    </div>
    @if (Model.LatestAlerts.Count == 0)
    {
        <p class="help">No approved reports yet.</p>
    }
    else
    {
        <div class="alert-grid">
            @foreach (var alert in Model.LatestAlerts)
            {
                <article class="card">
                    <h3><a asp-controller="ScamReports" asp-action="Details" asp-route-id="@alert.ReportId">@alert.CompanyName</a></h3>
                    <p class="help">@alert.Domain · @alert.RelativeDate</p>
                    <div class="chip-row">
                        <span class="badge badge-neutral">@alert.ScamType</span>
                        @if (alert.AmountRequestedUsd > 0)
                        {
                            <span class="badge badge-medium">@alert.AmountRequestedUsd.ToString("$#,##0.##")</span>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="section" aria-labelledby="path-title">
    <h2 id="path-title">Your path to a safe job</h2>
    <ol class="path-steps">
        <li class="card path-step">
            <span class="step" aria-hidden="true">1</span>
            <h3>Find a job</h3>
            <p>Browse live openings and JobLens postings with trust signals.</p>
            <a asp-controller="Jobs" asp-action="Index">Jobs</a>
        </li>
        <li class="card path-step">
            <span class="step" aria-hidden="true">2</span>
            <h3>Check it</h3>
            <p>Score the recruiter email and scan offer text before you reply.</p>
            <a asp-controller="CheckRecruiter" asp-action="Index">Check Recruiter</a>
            <span aria-hidden="true"> · </span>
            <a asp-controller="OfferAnalyzer" asp-action="Index">Offer Analyzer</a>
        </li>
        <li class="card path-step">
            <span class="step" aria-hidden="true">3</span>
            <h3>Apply safely</h3>
            <p>Run a resume privacy check and draft careful outreach.</p>
            <a asp-controller="Resume" asp-action="Index">My Resume</a>
            <span aria-hidden="true"> · </span>
            <a asp-controller="EmailDrafts" asp-action="Index">Email drafts</a>
        </li>
        <li class="card path-step">
            <span class="step" aria-hidden="true">4</span>
            <h3>Track it</h3>
            <p>Save roles, follow-ups, and risk signals in one pipeline.</p>
            <a asp-controller="Applications" asp-action="Index">My Applications</a>
        </li>
    </ol>
</section>

<section class="section" aria-labelledby="red-flag-title">
    <h2 id="red-flag-title">Red flag of the week</h2>
    <article class="card red-flag-card">
        <h3>@redFlag.Name</h3>
        <p>@redFlag.HowItWorks</p>
        <h4>Watch for</h4>
        <ul class="reason-list">
            @foreach (var flag in redFlag.RedFlags)
            {
                <li>@flag</li>
            }
        </ul>
        <h4>What to do</h4>
        <p>@redFlag.WhatToDo</p>
        <a class="btn btn-secondary"
           asp-controller="Chat"
           asp-action="Index"
           asp-route-q="@redFlag.ChatQuestion">Ask JobLens about this</a>
    </article>
</section>

<section class="section" aria-labelledby="sources-title">
    <h2 id="sources-title">Trusted data sources</h2>
    <ul class="source-chip-row" aria-label="Data sources">
        <li><a class="source-chip" title="Live domain registration lookups" asp-controller="About" asp-action="Architecture">RDAP</a></li>
        <li><a class="source-chip" title="SEC company registry matching" asp-controller="About" asp-action="Architecture">SEC EDGAR</a></li>
        <li><a class="source-chip" title="Federal job openings feed" asp-controller="About" asp-action="Architecture">USAJOBS</a></li>
        <li><a class="source-chip" title="Grounded chat answers when configured" asp-controller="About" asp-action="Architecture">Azure OpenAI</a></li>
        <li><a class="source-chip" title="Read-only MCP tools over SQLite" asp-controller="About" asp-action="Architecture">MCP</a></li>
    </ul>
</section>
