<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · JobLens Chat</title>
    <meta name="description" content="JobLens Chat helps university career-center staff and students ask questions about job and internship scams, with answers grounded in synthetic report data." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    @{
        var checkSection = controller is "CheckRecruiter" or "OfferAnalyzer";
        var dataSection = controller is "ScamReports" or "Companies" or "Recruiters" or "JobPostings" or "InterviewReviews";
    }
    <header class="site-header">
        <div class="container navbar">
            <a class="brand" asp-controller="Home" asp-action="Index">🛡️ JobLens Chat</a>
            <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">Menu</button>
            <nav id="site-nav" class="site-nav" aria-label="Main">
                <ul class="nav-links">
                    <li>
                        <a class="nav-link @(controller == "Home" ? "active" : null)"
                           asp-controller="Home"
                           asp-action="Index"
                           aria-current="@(controller == "Home" ? "page" : null)">Home</a>
                    </li>
                    <li class="nav-item" data-dropdown>
                        <button class="nav-link @(checkSection ? "active" : null)" type="button" data-dropdown-button aria-expanded="false" aria-controls="check-menu">Check</button>
                        <div id="check-menu" class="dropdown-panel" data-dropdown-panel hidden>
                            <a class="nav-link @(controller == "CheckRecruiter" ? "active" : null)" asp-controller="CheckRecruiter" asp-action="Index">Check Recruiter</a>
                            <a class="nav-link @(controller == "OfferAnalyzer" ? "active" : null)" asp-controller="OfferAnalyzer" asp-action="Index">Offer Analyzer</a>
                        </div>
                    </li>
                    <li class="nav-item" data-dropdown>
                        <button class="nav-link @(dataSection ? "active" : null)" type="button" data-dropdown-button aria-expanded="false" aria-controls="data-menu">Data</button>
                        <div id="data-menu" class="dropdown-panel" data-dropdown-panel hidden>
                            <a class="nav-link @(controller == "ScamReports" ? "active" : null)" asp-controller="ScamReports" asp-action="Index">Scam Reports</a>
                            <a class="nav-link @(controller == "Companies" ? "active" : null)" asp-controller="Companies" asp-action="Index">Companies</a>
                            <a class="nav-link @(controller == "Recruiters" ? "active" : null)" asp-controller="Recruiters" asp-action="Index">Recruiters</a>
                            <a class="nav-link @(controller == "JobPostings" ? "active" : null)" asp-controller="JobPostings" asp-action="Index">Job Postings</a>
                            <a class="nav-link @(controller == "InterviewReviews" ? "active" : null)" asp-controller="InterviewReviews" asp-action="Index">Interview Reviews</a>
                        </div>
                    </li>
                    <li>
                        <a class="nav-link @(controller == "Dashboard" ? "active" : null)"
                           asp-controller="Dashboard"
                           asp-action="Index"
                           aria-current="@(controller == "Dashboard" ? "page" : null)">Dashboard</a>
                    </li>
                    <li>
                        <a class="nav-link @(controller == "Chat" ? "active" : null)"
                           asp-controller="Chat"
                           asp-action="Index"
                           aria-current="@(controller == "Chat" ? "page" : null)">Chat</a>
                    </li>
                    <li>
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                    </li>
                </ul>
                <div class="nav-auth">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        <span class="nav-user">Hi, @User.Identity?.Name</span>
                        if (!string.IsNullOrEmpty(role))
                        {
                            <span class="role-badge">@role</span>
                        }
                        <form method="post" asp-controller="Account" asp-action="Logout" class="nav-logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary btn-nav">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link @(controller == "Account" ? "active" : null)"
                           asp-controller="Account"
                           asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-nav"
                           asp-controller="Account"
                           asp-action="Register">Register</a>
                    }
                </div>
            </nav>
        </div>
    </header>
    <main class="container">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <p>JobLens Chat · ISM 6225 · App Dev for Analytics · C# MVC + MCP + SQLite · Synthetic data only</p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
