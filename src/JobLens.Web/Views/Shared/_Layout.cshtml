<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · JobLens</title>
    <meta name="description" content="JobLens helps university career-center staff and students verify recruiters and explore synthetic job-scam reports with answers grounded in data." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%233B82F6'/%3E%3Cpath d='M32 10 L48 18 V34 C48 44 40 52 32 56 C24 52 16 44 16 34 V18 Z' fill='%23FFFFFF'/%3E%3Cpath d='M26 32 L30 36 L40 24' stroke='%233B82F6' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var checkSection = controller is "CheckRecruiter" or "OfferAnalyzer";
        var communitySection = controller is "ScamReports" or "Companies" or "Recruiters" or "InterviewReviews";
        var jobsSection = controller is "Jobs" or "JobPostings" or "LiveJobs";
        var myJobLensSection = controller is "Applications" or "EmailDrafts" or "Resume";
        var aboutSection = controller is "About";
        var year = DateTime.UtcNow.Year;
        var displayName = User.Identity?.Name ?? "Account";
        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    }
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="container navbar">
            <a class="brand" asp-controller="Home" asp-action="Index">JobLens</a>
            <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">Menu</button>
            <nav id="site-nav" class="site-nav" aria-label="Main">
                <ul class="nav-links">
                    <li class="nav-item" data-dropdown>
                        <button class="nav-link @(checkSection ? "active" : null)" type="button" data-dropdown-button aria-expanded="false" aria-controls="check-menu">Check <span class="nav-caret" aria-hidden="true">▾</span></button>
                        <div id="check-menu" class="dropdown-panel" data-dropdown-panel hidden>
                            <a class="nav-link @(controller == "CheckRecruiter" ? "active" : null)" asp-controller="CheckRecruiter" asp-action="Index">Check Recruiter</a>
                            <a class="nav-link @(controller == "OfferAnalyzer" ? "active" : null)" asp-controller="OfferAnalyzer" asp-action="Index">Offer Analyzer</a>
                        </div>
                    </li>
                    <li>
                        <a class="nav-link @(jobsSection ? "active" : null)"
                           asp-controller="Jobs"
                           asp-action="Index"
                           aria-current="@(jobsSection ? "page" : null)">Jobs</a>
                    </li>
                    <li class="nav-item" data-dropdown>
                        <button class="nav-link @(communitySection ? "active" : null)" type="button" data-dropdown-button aria-expanded="false" aria-controls="community-menu">Community <span class="nav-caret" aria-hidden="true">▾</span></button>
                        <div id="community-menu" class="dropdown-panel" data-dropdown-panel hidden>
                            <a class="nav-link @(controller == "ScamReports" ? "active" : null)" asp-controller="ScamReports" asp-action="Index">Scam Reports</a>
                            <a class="nav-link @(controller == "Companies" ? "active" : null)" asp-controller="Companies" asp-action="Index">Companies</a>
                            <a class="nav-link @(controller == "Recruiters" ? "active" : null)" asp-controller="Recruiters" asp-action="Index">Recruiters</a>
                            <a class="nav-link @(controller == "InterviewReviews" ? "active" : null)" asp-controller="InterviewReviews" asp-action="Index">Interview Reviews</a>
                        </div>
                    </li>
                    <li>
                        <a class="nav-link @(controller == "Dashboard" ? "active" : null)"
                           asp-controller="Dashboard"
                           asp-action="Index"
                           aria-current="@(controller == "Dashboard" ? "page" : null)">Dashboard</a>
                    </li>
                    <li>
                        <a class="nav-link @(controller == "Chat" ? "active" : null)"
                           asp-controller="Chat"
                           asp-action="Index"
                           aria-current="@(controller == "Chat" ? "page" : null)">Ask JobLens</a>
                    </li>
                    <li class="nav-item" data-dropdown>
                        <button class="nav-link @(aboutSection ? "active" : null)" type="button" data-dropdown-button aria-expanded="false" aria-controls="about-menu">About <span class="nav-caret" aria-hidden="true">▾</span></button>
                        <div id="about-menu" class="dropdown-panel" data-dropdown-panel hidden>
                            <a class="nav-link @(controller == "About" && action == "Index" ? "active" : null)" asp-controller="About" asp-action="Index">About Us</a>
                            <a class="nav-link @(controller == "About" && action == "Architecture" ? "active" : null)" asp-controller="About" asp-action="Architecture">Architecture</a>
                        </div>
                    </li>
                </ul>
                <div class="nav-auth">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-item" data-dropdown>
                            <button class="nav-link nav-user-button @(myJobLensSection ? "active" : null)"
                                    type="button"
                                    data-dropdown-button
                                    aria-expanded="false"
                                    aria-controls="user-menu">
                                <span class="nav-user-label">@displayName</span>
                                @if (!string.IsNullOrEmpty(role))
                                {
                                    <span class="role-badge">@role</span>
                                }
                                <span class="nav-caret" aria-hidden="true">▾</span>
                            </button>
                            <div id="user-menu" class="dropdown-panel dropdown-panel-end" data-dropdown-panel hidden>
                                <a class="nav-link @(controller == "Applications" ? "active" : null)" asp-controller="Applications" asp-action="Index">My Applications</a>
                                <a class="nav-link @(controller == "Resume" ? "active" : null)" asp-controller="Resume" asp-action="Index">My Resume</a>
                                <a class="nav-link @(controller == "EmailDrafts" ? "active" : null)" asp-controller="EmailDrafts" asp-action="Index">Email drafts</a>
                                <div class="dropdown-divider" role="separator"></div>
                                <form method="post" asp-controller="Account" asp-action="Logout" class="nav-logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link nav-logout-button">Log out</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link @(controller == "Account" && action == "Login" ? "active" : null)"
                           asp-controller="Account"
                           asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-nav"
                           asp-controller="Account"
                           asp-action="Register">Register</a>
                    }
                </div>
            </nav>
        </div>
    </header>
    <main id="main-content" class="container" tabindex="-1">
        <div aria-live="polite">
            <partial name="_Alerts" />
        </div>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <nav class="footer-links" aria-label="Footer">
                <a href="https://github.com/SathvikReddySirigiri/joblens-chat" target="_blank" rel="noopener">GitHub repo</a>
                <a href="https://github.com/SathvikReddySirigiri/joblens-chat/blob/main/docs/DOCUMENTATION.md" target="_blank" rel="noopener">Documentation</a>
            </nav>
            <p class="footer-disclaimer">Scam data is sample data for education.</p>
            <p class="footer-copy">© @year JobLens · ISM 6225</p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
