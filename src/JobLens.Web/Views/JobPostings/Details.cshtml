@model JobPosting
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTitle"] = Model.Title;
    ViewData["PageSubtitle"] = $"{Model.CompanyName} · {Model.PostedDate}";
    var company = ViewBag.Company as Company;
    var activity = (CompanyActivitySummary)ViewBag.Activity;
}
<partial name="_Alerts" />
<section class="page-header">
    <partial name="_PageHeader" />
    <div class="header-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary"
               asp-controller="Applications"
               asp-action="Create"
               asp-route-company="@Model.CompanyName"
               asp-route-title="@Model.Title"
               asp-route-source="JobLensPosting">Track this job</a>
            <form method="post" asp-controller="Resume" asp-action="Match" class="inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobTitle" value="@Model.Title" />
                <input type="hidden" name="companyName" value="@Model.CompanyName" />
                <input type="hidden" name="jobText" value="@Model.Description" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", "JobPostings", new { id = Model.PostingId })" />
                <button class="btn btn-secondary" type="submit">Match my resume</button>
            </form>
        }
        @if (ViewBag.IsModerator == true)
        {
            <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.PostingId">Edit</a>
            <a class="btn btn-secondary" asp-action="Delete" asp-route-id="@Model.PostingId">Delete</a>
        }
    </div>
</section>
@if (activity.ApprovedReports > 0 && company is not null)
{
    <p class="alert alert-error" role="alert">@activity.ApprovedReports scam reports impersonate this company — verify recruiters on the official domain @company.OfficialDomain.</p>
}
<section class="card">
    <dl class="detail-list">
        <div><dt>Company</dt><dd><a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.CompanyId">@Model.CompanyName</a></dd></div>
        <div><dt>Location</dt><dd>@Model.Location</dd></div>
        <div><dt>State</dt><dd>@Model.State</dd></div>
        <div><dt>Remote</dt><dd>@(Model.IsRemote ? "Yes" : "No")</dd></div>
        <div><dt>Paid</dt><dd>@(Model.IsPaid ? "Yes" : "No")</dd></div>
        <div><dt>Pay rate</dt><dd>@(Model.PayRatePerHour is null ? "—" : Model.PayRatePerHour.Value.ToString("$#,##0.00") + " per hour")</dd></div>
        <div><dt>Description</dt><dd>@Model.Description</dd></div>
    </dl>
</section>
