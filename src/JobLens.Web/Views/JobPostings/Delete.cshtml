@model JobPosting
@{
    ViewData["Title"] = "Delete job posting";
    ViewData["PageTitle"] = "Delete this posting?";
    ViewData["PageSubtitle"] = $"{Model.Title} · {Model.CompanyName} · {Model.PostedDate}. This cannot be undone.";
}
<partial name="_Alerts" />
<section class="page-header">
    <partial name="_PageHeader" />
</section>
<section class="card">
    <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.PostingId">
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Delete posting</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.PostingId">Cancel</a>
        </div>
    </form>
</section>
