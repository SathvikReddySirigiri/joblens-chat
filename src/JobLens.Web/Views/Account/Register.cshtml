@model RegisterFormVm
@{
    ViewData["Title"] = "Register";
    ViewData["PageTitle"] = "Create a student account";
    ViewData["PageSubtitle"] = "Registration creates a Student role. Moderators are provisioned by staff, not through this form.";
}

<section class="page-header">
    <partial name="_PageHeader" />
</section>

<section class="card auth-card">
    <form method="post" asp-controller="Account" asp-action="Register" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="DisplayName"></label>
            <input asp-for="DisplayName" autocomplete="name" />
            <span asp-validation-for="DisplayName" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <p class="help">At least 10 characters, with a letter and a digit.</p>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Register</button>
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">Already have an account?</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
